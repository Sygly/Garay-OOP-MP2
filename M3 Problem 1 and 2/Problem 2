import java.util.Scanner;
 
class BankAccount {
 
    private String accountNumber;
    private String ownerName;
    private double balance;
 
    private static int accountCount = 0;
 
    public BankAccount(String accountNumber, String ownerName, double balance) {
        this.accountNumber = accountNumber;
        this.ownerName = ownerName;
        this.balance = balance;
        accountCount++;
    }
 
    public String getAccountNumber() {
        return accountNumber;
    }
 
    public String getOwnerName() {
        return ownerName;
    }
 
    public double getBalance() {
        return balance;
    }
 
    public static int getAccountCount() {
        return accountCount;
    }
 
    public boolean deposit(double amount) {
        if (amount > 0) {
            balance = balance + amount;
            return true;
        }
        return false;
    }
 
    public boolean withdraw(double amount) {
        if (amount > 0 && amount <= balance) {
            balance = balance - amount;
            return true;
        }
        return false;
    }
}
 
// MAIN CLASS
public class BankAccountTransactionManager {
 
    public static void main(String[] args) {
 
        Scanner input = new Scanner(System.in);
 
        int numberOfAccounts;
 
        do {
            System.out.print("Enter number of accounts (1-5): ");
            numberOfAccounts = input.nextInt();
        } while (numberOfAccounts < 1 || numberOfAccounts > 5);
 
        BankAccount[] accounts = new BankAccount[numberOfAccounts];
 
        for (int i = 0; i < numberOfAccounts; i++) {
 
            System.out.println("\nAccount " + (i + 1));
 
            System.out.print("Account number: ");
            String accountNumber = input.next();
 
            input.nextLine();
 
            System.out.print("Owner name: ");
            String ownerName = input.nextLine();
 
            double openingBalance;
 
            do {
                System.out.print("Opening balance: ");
                openingBalance = input.nextDouble();
 
                if (openingBalance < 0) {
                    System.out.println("Opening balance cannot be negative.");
                }
 
            } while (openingBalance < 0);
 
            accounts[i] = new BankAccount(
                    accountNumber,
                    ownerName,
                    openingBalance
            );
        }
 
        System.out.print("\nHow many transactions? ");
        int transactions = input.nextInt();
 
        for (int i = 0; i < transactions; i++) {
 
            System.out.println("\nTransaction " + (i + 1));
 
            System.out.print("Account number: ");
            String targetAccount = input.next();
 
            System.out.print("Transaction type (D/W): ");
            char type = input.next().toUpperCase().charAt(0);
 
            System.out.print("Amount: ");
            double amount = input.nextDouble();
 
            BankAccount foundAccount = null;
 
            for (int j = 0; j < accounts.length; j++) {
                if (accounts[j].getAccountNumber().equals(targetAccount)) {
                    foundAccount = accounts[j];
                    break;
                }
            }
 
            if (foundAccount == null) {
 
                System.out.println("Transaction rejected: Account not found.");
 
            } else if (type == 'D') {
 
                if (foundAccount.deposit(amount)) {
                    System.out.println("Deposit successful.");
                } else {
                    System.out.println("Transaction rejected: Invalid deposit.");
                }
 
            } else if (type == 'W') {
 
                if (foundAccount.withdraw(amount)) {
                    System.out.println("Withdrawal successful.");
                } else {
                    System.out.println(
                            "Transaction rejected: Invalid amount or insufficient balance."
                    );
                }
 
            } else {
 
                System.out.println(
                        "Transaction rejected: Invalid transaction type."
                );
            }
        }
 
        System.out.println("\n===== FINAL ACCOUNT BALANCES =====");
 
        for (int i = 0; i < accounts.length; i++) {
 
            System.out.println(
                    "Account Number: " + accounts[i].getAccountNumber()
            );
 
            System.out.println(
                    "Owner: " + accounts[i].getOwnerName()
            );
 
            System.out.printf(
                    "Final Balance: %.2f%n%n",
                    accounts[i].getBalance()
            );
        }
 
        System.out.println(
                "Total accounts created: " + BankAccount.getAccountCount()
        );
 
        input.close();
    }
}
